{
  "uid": "app-ml-api",
  "title": "ml-api / Service health",
  "description": "ml-api: request rate, error share and latency of POST /predict from the app's own metrics, then what those depend on (ready pods and memory). Links in each panel lead to the app's SLO, pods and logs. The board ships with the app, from its folder in apps/base/.",
  "tags": [
    "apps"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "1m",
  "schemaVersion": 41,
  "version": 1,
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "sloth"
      ],
      "asDropdown": true,
      "title": "SLOs",
      "includeVars": false,
      "keepTime": true
    },
    {
      "type": "dashboards",
      "tags": [
        "apps"
      ],
      "asDropdown": true,
      "title": "Apps",
      "includeVars": false,
      "keepTime": true
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": [
      {
        "name": "Firing alerts",
        "datasource": {
          "type": "prometheus",
          "uid": "VictoriaMetrics"
        },
        "enable": true,
        "iconColor": "red",
        "expr": "ALERTS{alertstate=\"firing\", namespace=\"ml-api\"}",
        "step": "30s",
        "titleFormat": "{{alertname}}",
        "textFormat": "severity {{severity}}{{sloth_severity}}",
        "tagKeys": "severity,sloth_severity",
        "useValueForTime": false
      }
    ]
  },
  "panels": [
    {
      "id": 13,
      "type": "row",
      "title": "ml-api \u00b7 alerts",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 14,
      "type": "alertlist",
      "title": "Alerts",
      "description": "Firing and pending alerts in the ml-api namespace, read from vmalert: its SLO alerts (slo.yaml labels them with the namespace), workload alerts and ml-api's own rules.",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "options": {
        "datasource": "VictoriaMetrics",
        "alertInstanceLabelFilter": "{namespace=\"ml-api\"}",
        "alertName": "",
        "stateFilter": {
          "firing": true,
          "pending": true,
          "noData": false,
          "normal": false,
          "error": false,
          "recovering": false
        },
        "viewMode": "list",
        "groupMode": "default",
        "groupBy": [],
        "showInstances": false,
        "maxItems": 20,
        "sortOrder": 1,
        "dashboardAlerts": false
      }
    },
    {
      "id": 1,
      "type": "row",
      "title": "ml-api \u00b7 POST /predict",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Rate",
      "description": "Requests per second to POST /predict, by response status, counted by ml-api itself (`ml_api_requests_total`). Health and readiness probes are left out.",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "range": true,
          "expr": "sum by (status) (rate(ml_api_requests_total{namespace=\"ml-api\",endpoint=\"/predict\"}[$__rate_interval]))",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "2.."
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "5.."
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "links": [
        {
          "title": "SLO / Detail: ml-api",
          "url": "/d/slo-detail?var-service=ml-api&${__url_time_range}"
        },
        {
          "title": "Pods: namespace ml-api",
          "url": "/d/85a562078cdf77779eaa1add43ccec1e?var-namespace=ml-api&${__url_time_range}"
        },
        {
          "title": "Logs: namespace ml-api",
          "url": "/explore?schemaVersion=1&orgId=1&panes={\"a\":{\"datasource\":\"VictoriaLogs\",\"queries\":[{\"refId\":\"A\",\"datasource\":{\"type\":\"victoriametrics-logs-datasource\",\"uid\":\"VictoriaLogs\"},\"expr\":\"kubernetes.pod_namespace:=ml-api\",\"queryType\":\"instant\"}],\"range\":{\"from\":\"${__from}\",\"to\":\"${__to}\"}}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Errors",
      "description": "Share of POST /predict requests answered with a 5xx status. The dashed line is the error budget of the 99% availability SLO (1%); SLO / Detail shows the burn rate. ml-api counts every request as 200 (known issue in README.md), so this stays 0 until the app records its real status.",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "range": true,
          "expr": "(sum(rate(ml_api_requests_total{namespace=\"ml-api\",endpoint=\"/predict\",status=~\"5..\"}[$__rate_interval])) or vector(0)) / sum(rate(ml_api_requests_total{namespace=\"ml-api\",endpoint=\"/predict\"}[$__rate_interval]))",
          "legendFormat": "5xx share"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "dashed"
            },
            "axisSoftMax": 0.02
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.01
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "5xx share"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "links": [
        {
          "title": "SLO / Detail: ml-api",
          "url": "/d/slo-detail?var-service=ml-api&${__url_time_range}"
        },
        {
          "title": "Pods: namespace ml-api",
          "url": "/d/85a562078cdf77779eaa1add43ccec1e?var-namespace=ml-api&${__url_time_range}"
        },
        {
          "title": "Logs: namespace ml-api",
          "url": "/explore?schemaVersion=1&orgId=1&panes={\"a\":{\"datasource\":\"VictoriaLogs\",\"queries\":[{\"refId\":\"A\",\"datasource\":{\"type\":\"victoriametrics-logs-datasource\",\"uid\":\"VictoriaLogs\"},\"expr\":\"kubernetes.pod_namespace:=ml-api\",\"queryType\":\"instant\"}],\"range\":{\"from\":\"${__from}\",\"to\":\"${__to}\"}}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Duration",
      "description": "Latency percentiles of POST /predict, from ml-api's own histogram (`ml_api_request_duration_seconds`). The dashed line is the latency SLO threshold (1 s): 99% of requests must be faster.",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "range": true,
          "expr": "histogram_quantile(0.5, sum by (le) (rate(ml_api_request_duration_seconds_bucket{namespace=\"ml-api\",endpoint=\"/predict\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "range": true,
          "expr": "histogram_quantile(0.9, sum by (le) (rate(ml_api_request_duration_seconds_bucket{namespace=\"ml-api\",endpoint=\"/predict\"}[$__rate_interval])))",
          "legendFormat": "p90"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "range": true,
          "expr": "histogram_quantile(0.99, sum by (le) (rate(ml_api_request_duration_seconds_bucket{namespace=\"ml-api\",endpoint=\"/predict\"}[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "dashed"
            },
            "axisSoftMax": 1.0
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1.0
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "links": [
        {
          "title": "SLO / Detail: ml-api",
          "url": "/d/slo-detail?var-service=ml-api&${__url_time_range}"
        },
        {
          "title": "Pods: namespace ml-api",
          "url": "/d/85a562078cdf77779eaa1add43ccec1e?var-namespace=ml-api&${__url_time_range}"
        },
        {
          "title": "Logs: namespace ml-api",
          "url": "/explore?schemaVersion=1&orgId=1&panes={\"a\":{\"datasource\":\"VictoriaLogs\",\"queries\":[{\"refId\":\"A\",\"datasource\":{\"type\":\"victoriametrics-logs-datasource\",\"uid\":\"VictoriaLogs\"},\"expr\":\"kubernetes.pod_namespace:=ml-api\",\"queryType\":\"instant\"}],\"range\":{\"from\":\"${__from}\",\"to\":\"${__to}\"}}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Ready pods",
      "description": "Pods of ml-api that pass their readiness probe, against the desired count. At 0 the Service sends requests nowhere and the app's own metrics go quiet, so the SLOs see nothing; DeploymentUnavailable pages after 1 minute.",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "range": true,
          "expr": "max(kube_deployment_status_replicas_available{namespace=\"ml-api\",deployment=\"ml-api\"})",
          "legendFormat": "ready"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "range": true,
          "expr": "max(kube_deployment_spec_replicas{namespace=\"ml-api\",deployment=\"ml-api\"})",
          "legendFormat": "desired"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "ready"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "desired"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "text"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "links": [
        {
          "title": "SLO / Detail: ml-api",
          "url": "/d/slo-detail?var-service=ml-api&${__url_time_range}"
        },
        {
          "title": "Pods: namespace ml-api",
          "url": "/d/85a562078cdf77779eaa1add43ccec1e?var-namespace=ml-api&${__url_time_range}"
        },
        {
          "title": "Logs: namespace ml-api",
          "url": "/explore?schemaVersion=1&orgId=1&panes={\"a\":{\"datasource\":\"VictoriaLogs\",\"queries\":[{\"refId\":\"A\",\"datasource\":{\"type\":\"victoriametrics-logs-datasource\",\"uid\":\"VictoriaLogs\"},\"expr\":\"kubernetes.pod_namespace:=ml-api\",\"queryType\":\"instant\"}],\"range\":{\"from\":\"${__from}\",\"to\":\"${__to}\"}}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Memory",
      "description": "Memory per ml-api pod: the container's working set (what the kernel compares with the limit), the part ml-api reports it allocated itself (`ml_api_memory_bytes`), and the limit. At the limit the container is OOM-killed (ContainerOOMKilled); above 90% for 5 minutes ContainerMemoryNearLimit fires.",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 8,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "range": true,
          "expr": "max by (pod) (container_memory_working_set_bytes{namespace=\"ml-api\",container=\"ml-api\"})",
          "legendFormat": "{{pod}} working set"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "range": true,
          "expr": "max by (pod) (ml_api_memory_bytes{namespace=\"ml-api\"})",
          "legendFormat": "{{pod}} allocated by app"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "range": true,
          "expr": "max(kube_pod_container_resource_limits{namespace=\"ml-api\",container=\"ml-api\",resource=\"memory\"})",
          "legendFormat": "limit"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "limit"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "links": [
        {
          "title": "SLO / Detail: ml-api",
          "url": "/d/slo-detail?var-service=ml-api&${__url_time_range}"
        },
        {
          "title": "Pods: namespace ml-api",
          "url": "/d/85a562078cdf77779eaa1add43ccec1e?var-namespace=ml-api&${__url_time_range}"
        },
        {
          "title": "Logs: namespace ml-api",
          "url": "/explore?schemaVersion=1&orgId=1&panes={\"a\":{\"datasource\":\"VictoriaLogs\",\"queries\":[{\"refId\":\"A\",\"datasource\":{\"type\":\"victoriametrics-logs-datasource\",\"uid\":\"VictoriaLogs\"},\"expr\":\"kubernetes.pod_namespace:=ml-api\",\"queryType\":\"instant\"}],\"range\":{\"from\":\"${__from}\",\"to\":\"${__to}\"}}}"
        }
      ]
    },
    {
      "type": "row",
      "id": 11,
      "title": "ml-api \u00b7 logs",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "panels": []
    },
    {
      "type": "logs",
      "id": 12,
      "title": "Logs",
      "description": "The container logs of namespace ml-api from VictoriaLogs for the dashboard's time range, newest first. Successful health, readiness and metrics requests are hidden; failed ones stay. The controls on the right filter by level; the panel link opens every line in Explore.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "VictoriaLogs"
      },
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 25
      },
      "links": [
        {
          "title": "All logs of namespace ml-api in Explore",
          "url": "/explore?schemaVersion=1&orgId=1&panes={\"a\":{\"datasource\":\"VictoriaLogs\",\"queries\":[{\"refId\":\"A\",\"datasource\":{\"type\":\"victoriametrics-logs-datasource\",\"uid\":\"VictoriaLogs\"},\"expr\":\"kubernetes.pod_namespace:=ml-api\",\"queryType\":\"instant\"}],\"range\":{\"from\":\"${__from}\",\"to\":\"${__to}\"}}}"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "enableInfiniteScrolling": true,
        "showControls": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none",
        "prettifyLogMessage": false
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "VictoriaLogs"
          },
          "expr": "kubernetes.pod_namespace:=ml-api -~'\"GET /(health|ready|metrics) HTTP/[0-9.]+\" 200 '",
          "queryType": "instant"
        }
      ]
    }
  ]
}
